# Stripe — card-on-file + post-session billing.
# Dashboard: https://dashboard.stripe.com (test mode first; keys start with pk_test_/sk_test_).
# Only the publishable key is safe for the browser — never expose the
# secret key or webhook signing secret to client-side JavaScript.

NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=""
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""

# Admin operations (complete / charge / retry / refund / payment status).
# Required until a real admin auth system exists — server-side only.
ADMIN_API_KEY=""

# Supabase — booking database (server-side service role; never expose).
SUPABASE_URL=""
SUPABASE_SERVICE_ROLE_KEY=""

# Google Ads offline conversion upload (optional — bookings with a gclid
# are attributed to your conversion action after successful vaulting).
GOOGLE_ADS_CONVERSION_ACTION_ID=""
GOOGLE_ADS_CUSTOMER_ID=""
GOOGLE_ADS_DEVELOPER_TOKEN=""
GOOGLE_ADS_REFRESH_TOKEN=""
GOOGLE_ADS_OAUTH_CLIENT_ID=""
GOOGLE_ADS_OAUTH_CLIENT_SECRET=""

# Site URL — builds manage/ics links in emails.
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# Email worker — cron secret + provider (console = log only).
CRON_SECRET=""
EMAIL_PROVIDER="console"
EMAIL_FROM="True Self Me <bookings@trueselfme.com>"
# RESEND_API_KEY=""  (set EMAIL_PROVIDER=resend to use Resend)
