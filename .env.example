# Stripe — card-on-file + post-session billing.
# Dashboard: https://dashboard.stripe.com (test mode first; keys start with pk_test_/sk_test_).
# Only the publishable key is safe for the browser — never expose the
# secret key or webhook signing secret to client-side JavaScript.

NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=""
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""

# Reserved for a future admin API. NOT read by any current route —
# safe to leave empty. (Never repurpose an existing secret for this.)
ADMIN_API_KEY=""

# Supabase — booking database (server-side service role; never expose).
SUPABASE_URL=""
SUPABASE_SERVICE_ROLE_KEY=""

# Google Ads server-side conversions — Data Manager API (Phase 7).
# 1. Google Cloud: enable the Data Manager API, create a service
#    account, download a key JSON. Paste its client_email and
#    private_key here (keep \n escapes in the private key).
# 2. Google Ads: grant the service-account email access to the account
#    (directly or via a manager account), then in Google Ads
#    Tools → Data manager create conversion actions for the events
#    "booking_confirmed" and "session_paid" and paste their action ids.
GOOGLE_SERVICE_ACCOUNT_EMAIL=""
GOOGLE_SERVICE_ACCOUNT_PRIVATE_KEY=""
GOOGLE_ADS_CUSTOMER_ID=""
GOOGLE_ADS_BOOKING_CONFIRMED_ACTION_ID=""
GOOGLE_ADS_SESSION_PAID_ACTION_ID=""
GOOGLE_ADS_LEAD_ACTION_ID=""
# Value reported per paid lead, in CENTS. Empty = value omitted.
GOOGLE_ADS_LEAD_CONVERSION_VALUE_CENTS=""
# Fixed value reported for booking_confirmed, in CENTS (e.g. "7500" =
# $75.00). Empty = value omitted; the conversion action's own default
# applies. session_paid always reports the ACTUAL collected amount.
GOOGLE_ADS_BOOKING_CONVERSION_VALUE_CENTS=""
# Advertising consent default until a consent-management platform is
# wired in ("granted"/"denied"). "denied" suppresses user-identifier
# uploads entirely; click-id conversions still flow. Never infer this
# from the card-on-file consent.
ADS_CONSENT_DEFAULT="denied"

# Site URL — builds manage/ics links in emails.
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# Email worker — required for POST /api/jobs/process-emails. Vercel Cron
# sends it automatically as a Bearer token; external schedulers can send
# the "x-cron-secret" header instead. Empty = worker disabled (503).
CRON_SECRET=""
EMAIL_PROVIDER="console"
EMAIL_FROM="True Self Me <bookings@trueselfme.com>"
# RESEND_API_KEY=""  (set EMAIL_PROVIDER=resend to use Resend)

# Google Ads automation guardrails (Phase 11) — DRY-RUN BY DEFAULT.
# 'live' mode + a connected Google Ads API mutator are required before
# any real campaign mutation; until then every action is recorded with
# dry_run = true and nothing is sent to Google.
ADS_AUTOMATION_MODE="dry_run"
ADS_DAILY_BUDGET_CENTS="3500"
ADS_CHECKPOINT_SPEND_CENTS="40000"
ADS_CHECKPOINT_MIN_LEADS="5"
ADS_TOTAL_CEILING_CENTS="100000"
ADS_CEILING_WARN_FRACTION="0.8"
ADS_ANOMALY_FACTOR="2"
ADS_OUTAGE_SUSTAINED_MINUTES="15"
ADS_PAUSE_ON_SITE_OUTAGE="false"
ADS_STRIPE_SETUP_FAILURE_RATE="0.5"
ADS_STRIPE_SETUP_MIN_ATTEMPTS="5"
ADS_PAUSE_ON_STRIPE_BREAK="false"
ADS_PIPELINE_STOPPED_MINUTES="360"
