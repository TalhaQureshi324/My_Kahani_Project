# Authorize.Net — card-on-file (Accept Hosted payment profiles).
# Sandbox credentials: https://sandbox.authorize.net (Account → API Credentials & Keys)
# AUTHORIZENET_ENVIRONMENT must be "SANDBOX" or "PRODUCTION" and must match
# the credentials used (sandbox credentials only work in SANDBOX).
# NEXT_PUBLIC_* values are safe for the browser; never expose the
# transaction key or signature key.

NEXT_PUBLIC_AUTHORIZENET_API_LOGIN_ID=""
NEXT_PUBLIC_AUTHORIZENET_PUBLIC_CLIENT_KEY=""
AUTHORIZENET_TRANSACTION_KEY=""
AUTHORIZENET_SIGNATURE_KEY=""
AUTHORIZENET_ENVIRONMENT="SANDBOX"

# Supabase — booking database (server-side service role; never expose).
SUPABASE_URL=""
SUPABASE_SERVICE_ROLE_KEY=""

# Google Ads offline conversion upload (optional — bookings with a gclid
# are attributed to your conversion action after successful vaulting).
GOOGLE_ADS_CONVERSION_ACTION_ID=""
GOOGLE_ADS_CUSTOMER_ID=""
GOOGLE_ADS_DEVELOPER_TOKEN=""
GOOGLE_ADS_REFRESH_TOKEN=""
GOOGLE_ADS_OAUTH_CLIENT_ID=""
GOOGLE_ADS_OAUTH_CLIENT_SECRET=""

# Supabase — booking database (server-side service role; never expose).
SUPABASE_URL=""
SUPABASE_SERVICE_ROLE_KEY=""

# Site URL — builds manage/ics links in emails.
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# Email worker — cron secret + provider (console = log only).
CRON_SECRET=""
EMAIL_PROVIDER="console"
EMAIL_FROM="True Self Me <bookings@trueselfme.com>"
# RESEND_API_KEY=""  (set EMAIL_PROVIDER=resend to use Resend)
